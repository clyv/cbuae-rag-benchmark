# Source documents are fetched by scripts/download_corpus.py, never committed.
corpus/raw/*
!corpus/raw/.gitkeep
corpus/processed/*
!corpus/processed/.gitkeep
corpus/manifest.json

# Indexes are rebuilt from the corpus
*.faiss
*.index
indexes/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Generated from results/demo.json by scripts/build_demo_page.py.
results/demo.html

# Local experiment caches (embedding matrices, not source).
.cache/
